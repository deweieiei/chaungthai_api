# ===========================================
# ChaungThai API - .env Template
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chaungthai

# Bcrypt cost factor (10-12 = สมดุลเร็ว/ปลอดภัย)
BCRYPT_ROUNDS=12
