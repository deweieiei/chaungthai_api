# ===========================================
# ChaungThai API - .env Template
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chaungthai

# Bcrypt cost factor (10-12 = สมดุลเร็ว/ปลอดภัย)
BCRYPT_ROUNDS=12

# JWT (สำหรับ login token)
# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Mock email/SMS gateway: ส่ง token/OTP กลับใน response
# true = MVP mode (ยังไม่มี email/SMS gateway)
# false = production จริง (ต้องตั้ง gateway ก่อน)
EXPOSE_MOCK_TOKENS=true

# CORS - origin ที่อนุญาตให้เรียก API ข้าม origin (คั่นด้วย comma)
# ถ้าว่าง = allow all (dev/test เท่านั้น)
# production ใส่ specific เช่น: http://110.171.128.44:8086,https://yourdomain.com
CORS_ORIGINS=

# Uploads (รูปโปรไฟล์ + portfolio)
# ใส่ absolute path ถ้าอยาก เก็บนอก project (เช่น /home/user/uploads)
# ถ้าว่าง = ใช้ <project>/uploads/
UPLOADS_DIR=
# ขนาดสูงสุดต่อไฟล์ (bytes)
UPLOAD_MAX_BYTES=5242880
